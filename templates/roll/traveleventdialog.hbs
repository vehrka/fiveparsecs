{{!-- Travel Event Dialog Template --}}
<form class="fp roll-dialog">
  <header class="roll-header">
    <h1 class="fp roll-name dialog-header">{{localize "FP.campaign_turn.travel.event"}}</h1>
  </header>
  <div class="form-group">
    <table class="fp dialog-roster">
      <tr class="fp terminal">
        <th>{{localize "FP.campaign_turn.travel.event"}}</th>
        <td style="text-align:center">
          <input class="fp text-input" id="tev" name="tev" type="text" value="" style="width:100%" />
        </td>
      </tr>
    </table>
  </div>
</form>
