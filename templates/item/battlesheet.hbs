<div class="fp {{cssClass}}">
    <header class="sheet-header">
        <img src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
        <h1><input name="name" type="text" value="{{item.name}}" placeholder="Name"/></h1>
    </header>
    <section class="sheetbody">
      
        <div class="fp flexcol">
            <h3 class="fp sheet-label left-larger" style="font-size:1em;">Basic Info</h3>
            <table class="fp item-roster">
                <tr>
                    <th class="fp terminal left-larger">Battle Type</th>
                    <td>{{> 'systems/fiveparsecs/templates/partials/battle/battletypeselect.hbs'}}</td>
                </tr>
                <tr>
                    <th class="fp terminal left-larger">Objective</th>
                    <td><input class="fp text-input" name="system.objective" value="{{data.objective}}" data-dtype="String"/></td>
                </tr>
                <tr>
                    <th class="fp terminal left-larger">Deployment</th>
                    <td><input class="fp text-input" name="system.deployment" value="{{data.deployment}}" data-dtype="String"/></td>
                </tr>
                <tr>
                    <th class="fp terminal left-larger">Outcome</th>
                    <td>
                        <select name="system.outcome" id="system.outcome">
                            {{{selectOptions battleOutcomeOptions selected=system.outcome}}}
                        </select>
                    </td>
                </tr>
                <tr>
                    <th class="fp terminal left-larger">Objective Complete</th>
                    <td>
                         <input type="checkbox" name="system.obj_complete" {{#if data.obj_complete}}checked{{/if}}/>
                    </td>
                </tr>
                
            </table>
            <h3 class="fp sheet-label left-larger">Opposition</h3>
            <table class="fp item-roster">
                <tr>
                    <th class="fp terminal left-larger">Enemy Category</th>
                    <td>
                        <select name="system.opposition.element" id="system.opposition.element">
                            {{{selectOptions oppositionElementOptions selected=system.opposition.element}}}
                        </select>
                    </td>
                </tr>
                <tr>
                    <th class="fp terminal left-larger">Main Opposition</th>
                    <td>
                        <input type="text" class="fp text-input" style="width:50%" name="system.opposition.element_subtype" value="{{data.opposition.element_subtype}}" data-dtype="String"/> x
                        <input type="text" class="fp value-input" name="system.opposition.base_number" value="{{data.opposition.base_number}}" data-dtype="Number"/>
                    </td>
                </tr>
                <tr>
                    <th class="fp terminal left-larger">Specialists</th>
                    <td>
                        <input type="text" class="fp value-input" name="system.opposition.specialists" value="{{data.opposition.specialists}}" data-dtype="String"/>
                    </td>
                </tr>
                <tr>
                    <th class="fp terminal left-larger">Unique Individuals</th>
                    <td>
                        <input type="text" class="fp text-input" name="system.opposition.unique_type" value="{{data.opposition.unique_type}}" data-dtype="String"/>
                    </td>
                </tr>
            </table>
        </div>
    
    </section>
</div>