<div class="fp {{cssClass}}">
    <header class="sheet-header">
        <img src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
        <h1><input name="name" type="text" value="{{item.name}}" placeholder="Name"/></h1>
    </header>
    <section class="sheetbody">
     <p class="terminal">{{localize "FP.ui.instructions.assign_crew_basics"}}</p>
        <div class="fp flexrow">
            
            <table class="fp item-roster">
                <tr>
                    <th class="terminal left-larger">{{localize "FP.ui.instructions.select_linked_character"}}</th>
                </tr>
                <tr>
                    <td>
                        <select name="system.assigned_crew_actorId" id="system.assigned_crew_actorId">
                            {{{selectOptions eligibleCrewOptions selected=system.assigned_crew_actorId}}}
                        </select>
                    </td>
                </tr>
            </table>
        </div>

    </section>
</div>